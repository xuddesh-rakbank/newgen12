public String clickEvent(IFormReference iform, String controlName, String data) {
    DigitalAO.mLogger.info("[DAOTemplate] Received request for: " + controlName);

    if (controlName.equalsIgnoreCase("Generate_RiskScore")) {
        DigitalAO.mLogger.debug("[DAOTemplate] Initializing Real-time CRAM Logic via Kong.");

        // 1. Invoke the Process-Specific Logic Layer
        // This handles DB configs, Token acquisition, and the JSON POST
        DigitalAO_CramLogic logic = new DigitalAO_CramLogic();
        String apiResult = logic.triggerRiskCalculation(iform);

        DigitalAO.mLogger.info("[DAOTemplate] API Execution Result: " + apiResult);
        
        // Return the response back to the JS layer (split by ~)
        return apiResult;
    }
    
    // Maintain existing template generation for other controls
    return ""; 
}





