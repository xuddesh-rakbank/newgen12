function validateAccountSummaryBeforeProceed() {
    var isNtb = getValue("is_Ntb");
    var decision = getValue("Decision");
    var accountType = getValue("product_type");
    var dedupeMatch = getValue("Dedupe_Match_found");
    if ((isNtb === 'N' && decision === "Approve" &&(ActivityName === 'operations' || ActivityName === 'compliance' || ActivityName === 'compliance_wc'))||(isNtb === 'Y' && dedupeMatch === 'Y' && decision === "Approve" &&(ActivityName === 'operations' || ActivityName === 'compliance' || ActivityName === 'compliance_wc'))) {
        var response = executeServerEvent("AccountSummary", "click", "", true);
        if (response === 'Inserted') {
            refreshFrame("Frame_ExposureDetails", true);
            var tableId = "table21";
            var rowCount = getGridRowCount(tableId);
            if (rowCount > 0) {
                var allowedSchemes =getValue("ldaccounts");
                let hasAllowedODA = false;
                let hasNonAllowedODA = false;
                for (let i = 0; i < rowCount; i++) {
                    var acctType = getValueFromTableCell(tableId, i, 0);
                    var crnCode = getValueFromTableCell(tableId, i, 2);
                    var scheme = getValueFromTableCell(tableId, i, 1);
                    if (accountType === "Savings Account" && acctType === "SBA") { showMessage("Decision", "Customer has a Savings Account. Kindly select the Reject Reason from dropdown & Reject the WI.", "error"); return false; }
                    if (accountType === "Current Account" && (dedupeMatch === 'Y' || dedupeMatch === 'N') && acctType === "ODA" && crnCode === "AED") {
                        if (allowedSchemes.includes(scheme)) { hasAllowedODA = true; } else { hasNonAllowedODA = true; }
                    }
                }
                if (hasAllowedODA && hasNonAllowedODA) { showMessage("Decision", "Customer has a Current Account. Kindly select the Reject Reason from dropdown & Reject the WI.", "error"); return false; }
                if (hasNonAllowedODA) { showMessage("Decision", "Customer has a Current Account. Kindly select the Reject Reason from dropdown & Reject the WI.", "error"); return false; }
                return true;
            }
        }
        return true;
    }
    return true;
}

