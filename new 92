			break;
			
		case 'table3_document_status_change':
			if(ActivityName=='Additional_cust_details'){ setControlValue("Decision",''); }
			break;
		
		case 'Decision_change':
			if(getValue("Decision")=="Additional Details required from Customer" && ActivityName=='Additional_cust_details'){ validation_on_Decision_change(); break; }
			if(getValue("Decision")=="Additional details needed" && (ActivityName=='sign_upload_checker' || ActivityName=='wm_control')){ validation_on_Decision_change(); break; }
